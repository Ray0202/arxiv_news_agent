# TEMPLATE ONLY — this file IS committed to git.
# DO NOT put real keys here. Copy to `.env` (gitignored) and fill that in:
#     cp .env.example .env

# One key per provider you actually use; an unused provider needs no key.
# Which one is required follows from `models:` in config/interests.yaml.
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Phase 2 (enrich). Free key raises the rate limit; the pipeline works without it.
SEMANTIC_SCHOLAR_API_KEY=

# Phase 2 (enrich). Used to verify that a paper's advertised repo actually exists.
GITHUB_TOKEN=

# Polite-pool identifier for OpenAlex (Phase 2). Any real mailbox you own.
OPENALEX_MAILTO=you@example.com
